__pycache__/
*.pyc
.venv/
*.stl
*.step
*.glb
*.a3d.json
# files the app exported, kept for the owner to open in other programs
!samples/ExportFromOurApp/**
# the 🎬 demo projects the app opens (auto3d/demos.py)
!demos/*.a3d.json
data/

# agents' own copies of the repository (git worktrees)
.claude/worktrees/

# files from other programs to import (samples/ToImportToOurApp/README.md: sources and licences)
!samples/ToImportToOurApp/**

# the Windows build (tools/build/build.py): its venv, PyInstaller output, the zip and the installer
/build/
/dist/
*.exe
*.msi
*-portable.zip
